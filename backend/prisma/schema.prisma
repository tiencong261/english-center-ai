// Prisma schema for english-center-ai MVP with Authentication & AI Features
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ============= AUTH & USER MODELS =============
model User {
  id        Int   @id @default(autoincrement())
  email     String   @unique
  password  String   // hashed password
  fullName  String   @map("full_name")
  phone     String?
  role      String   @default("student") // admin, staff, student
  avatar    String?
  isActive  Boolean  @default(true)
  
  // Relations
  student   Student?
  staff     Staff?
  sentMessages Message[] @relation("sender")
  receivedMessages Message[] @relation("receiver")
  submissions StudentSubmission[]
  feedbacks Feedback[]
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Student {
  id        Int   @id @default(autoincrement())
  userId    Int   @unique
  user      User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  fullName  String   @map("full_name")
  phone     String?
  email     String?  @unique
  level     String?  // A1, A2, B1, B2, C1, C2
  parentEmail String?
  parentPhone String?
  
  // Relations
  leads     Lead[]
  enrolls   Enrollment[]
  attendance Attendance[]
  submissions StudentSubmission[]
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Staff {
  id        Int   @id @default(autoincrement())
  userId    Int   @unique
  user      User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  position  String?  // teacher, manager, admin
  department String?
  
  createdAt DateTime @default(now())
}

model Course {
  id        Int   @id @default(autoincrement())
  name      String
  code      String  @unique
  description String?
  fee       Decimal?
  durationWeeks Int?
  level     String?
  maxCapacity Int?
  
  classes   Class[]
  enrolls   Enrollment[]
  
  createdAt DateTime @default(now())
}

model Class {
  id        Int   @id @default(autoincrement())
  courseId  Int
  course    Course @relation(fields: [courseId], references: [id])
  
  name      String
  schedule  String  // e.g., "Mon/Wed/Fri 10:00-12:00"
  startDate DateTime
  endDate   DateTime?
  capacity  Int
  
  enrolls   Enrollment[]
  
  createdAt DateTime @default(now())
}

model Enrollment {
  id        Int   @id @default(autoincrement())
  studentId Int
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  
  classId   Int
  class     Class @relation(fields: [classId], references: [id], onDelete: Cascade)

  courseId Int
  course   Course @relation(fields: [courseId], references: [id])
  
  status    String  @default("active")  // active, completed, dropped
  enrollDate DateTime @default(now())
  completionDate DateTime?
  
  createdAt DateTime @default(now())
  
  @@unique([studentId, classId])
}

model Attendance {
  id        Int   @id @default(autoincrement())
  studentId Int
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  
  classDate DateTime
  present   Boolean
  remarks   String?
  notified  Boolean @default(false)
  
  createdAt DateTime @default(now())
}

model Lead {
  id        Int   @id @default(autoincrement())
  name      String
  phone     String
  intent    String?
  target    String?
  level     String?
  metadata  Json?
  
  studentId Int?
  student   Student? @relation(fields: [studentId], references: [id], onDelete: SetNull)
  
  convertedTo Boolean @default(false)
  
  createdAt DateTime @default(now())
}

// ============= MESSAGING MODELS =============
model Message {
  id        Int   @id @default(autoincrement())
  senderId  Int
  sender    User  @relation("sender", fields: [senderId], references: [id], onDelete: Cascade)
  
  receiverId Int
  receiver  User  @relation("receiver", fields: [receiverId], references: [id], onDelete: Cascade)
  
  content   String
  isRead    Boolean @default(false)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@index([senderId])
  @@index([receiverId])
}

// ============= SUBMISSION & FEEDBACK MODELS =============
model StudentSubmission {
  id        Int   @id @default(autoincrement())
  studentId Int
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  
  userId    Int
  user      User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  title     String
  content   String  @db.Text
  attachmentUrl String?
  submissionType String  // essay, exercise, homework, etc
  
  score     Float?
  feedback  Feedback[]
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Feedback {
  id        Int   @id @default(autoincrement())
  submissionId Int
  submission StudentSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  
  userId    Int
  user      User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  comment   String  @db.Text
  score     Float?
  aiGenerated Boolean @default(false)
  aiModel   String?  // gpt-4, claude-3, etc
  strengths String  @db.Text
  areasForImprovement String  @db.Text
  suggestions String  @db.Text
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}